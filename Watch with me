<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assista Comigo / Watch With Me v2.0 PRO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0a0a0d;
            --bg-card: rgba(22, 22, 29, 0.8);
            --bg-card-hover: rgba(35, 35, 45, 0.95);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-color: rgba(255, 255, 255, 0.1);
            --accent-red: #be123c;
            --accent-red-bright: #e11d48;
            --accent-dark-red: #4c0519;
            --glass-blur: blur(14px);
        }

        body.light-theme {
            --bg-main: #ffffff;
            --bg-card: rgba(248, 250, 252, 0.95);
            --bg-card-hover: rgba(241, 245, 249, 1);
            --text-main: #0f172a;
            --text-muted: #475569;
            --border-color: rgba(0, 0, 0, 0.12);
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .glass-panel {
            background: var(--bg-card);
            backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-color);
        }

        .red-gradient {
            background: linear-gradient(135deg, var(--accent-dark-red) 0%, var(--accent-red) 55%, var(--accent-red-bright) 100%);
        }

        .red-glow {
            box-shadow: 0 0 28px rgba(225, 29, 72, 0.45);
        }

        select option {
            background-color: #16161d;
            color: #f3f4f6;
        }
        body.light-theme select option {
            background-color: #ffffff;
            color: #0f172a;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-main);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--accent-red);
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 glass-panel border-b border-rose-900/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- High-Impact Logo with TV, Globe & v2.0 PRO Badge -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('live')">
                    <div class="relative flex items-center justify-center w-14 h-14 rounded-2xl red-gradient red-glow border border-rose-400/30">
                        <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
                            <polyline points="17 2 12 7 7 2"></polyline>
                            <circle cx="12" cy="14.5" r="4.5"></circle>
                            <path d="M7.5 14.5h9M12 10a7 7 0 0 1 0 9M12 10a7 7 0 0 0 0 9"></path>
                        </svg>
                        <span class="absolute -bottom-1.5 -right-1.5 bg-amber-400 text-black text-[9px] font-black px-1.5 py-0.5 rounded-md shadow-md tracking-tighter border border-black/20">
                            v2.0
                        </span>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span id="brand-name" class="font-black text-xl sm:text-2xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-rose-500 via-red-500 to-rose-300">
                                ASSISTA COMIGO
                            </span>
                            <span class="hidden sm:inline-block bg-amber-400 text-black text-[10px] font-extrabold px-2 py-0.5 rounded shadow-sm tracking-widest uppercase">
                                v2.0 PRO
                            </span>
                        </div>
                        <p class="text-[11px] text-rose-500 font-semibold tracking-widest uppercase">Global Live Sports Streaming</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex space-x-1.5 glass-panel p-1.5 rounded-xl">
                    <button onclick="switchTab('live')" id="tab-btn-live" class="nav-tab px-4 py-2 rounded-lg text-sm font-semibold transition-all red-gradient text-white shadow">
                        <i class="fa-solid fa-play mr-2"></i><span data-i18n="navLive">Ao Vivo & Navegação</span>
                    </button>
                    <button onclick="switchTab('search')" id="tab-btn-search" class="nav-tab px-4 py-2 rounded-lg text-sm font-semibold transition-all hover:bg-rose-900/20">
                        <i class="fa-solid fa-magnifying-glass mr-2"></i><span data-i18n="navSearch">Pesquisa & Filtros</span>
                    </button>
                    <button onclick="switchTab('news')" id="tab-btn-news" class="nav-tab px-4 py-2 rounded-lg text-sm font-semibold transition-all hover:bg-rose-900/20">
                        <i class="fa-solid fa-newspaper mr-2"></i><span data-i18n="navNews">Notícias Esportivas</span>
                    </button>
                </nav>

                <!-- Theme Toggle & Language Switcher -->
                <div class="flex items-center space-x-2.5">
                    <button onclick="toggleTheme()" title="Alternar Tema Claro/Escuro" class="p-2.5 rounded-xl glass-panel hover:border-rose-500 transition-all text-rose-500">
                        <i id="theme-icon" class="fa-solid fa-sun text-lg"></i>
                    </button>

                    <select id="lang-select" onchange="changeLanguage(this.value)" class="glass-panel text-xs font-bold px-3 py-2.5 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 cursor-pointer">
                        <option value="pt">🇧🇷 Português</option>
                        <option value="en">🇺🇸 English</option>
                        <option value="es">🇪🇸 Español</option>
                        <option value="zh">🇨🇳 中文 (Mandarin)</option>
                        <option value="ja">🇯🇵 日本語 (Japanese)</option>
                        <option value="ar">🇸🇦 العربية (Arabic)</option>
                        <option value="de">🇩🇪 Deutsch</option>
                    </select>
                </div>
            </div>

            <!-- Mobile Nav Bar -->
            <div class="flex md:hidden justify-around pb-3 gap-1">
                <button onclick="switchTab('live')" id="mob-btn-live" class="flex-1 py-2 rounded-lg text-xs font-bold red-gradient text-white">Ao Vivo</button>
                <button onclick="switchTab('search')" id="mob-btn-search" class="flex-1 py-2 rounded-lg text-xs font-bold glass-panel">Pesquisa</button>
                <button onclick="switchTab('news')" id="mob-btn-news" class="flex-1 py-2 rounded-lg text-xs font-bold glass-panel">Notícias</button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- TAB 1: LIVE & 5-TIER HIERARCHICAL NAVIGATION -->
        <div id="tab-live-content" class="space-y-6">
            
            <!-- Hierarchical Filter Selector Bar -->
            <div class="glass-panel p-4 rounded-2xl border border-rose-900/30">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold text-rose-500 uppercase tracking-widest flex items-center">
                        <i class="fa-solid fa-sitemap mr-2"></i> <span data-i18n="hierarchicalNav">Esporte > País > Liga > Time > Jogador</span>
                    </h3>
                    <button onclick="resetFilters()" class="text-xs text-rose-500 hover:underline font-semibold">
                        <i class="fa-solid fa-rotate-left mr-1"></i> Limpar Filtros
                    </button>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div>
                        <label class="block text-[10px] uppercase font-bold mb-1 opacity-75" data-i18n="labelSport">1. Esporte</label>
                        <select id="filter-sport" onchange="onSportChange()" class="w-full glass-panel text-sm p-2.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todos os Esportes</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold mb-1 opacity-75" data-i18n="labelCountry">2. País</label>
                        <select id="filter-country" onchange="onCountryChange()" class="w-full glass-panel text-sm p-2.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todos os Países</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold mb-1 opacity-75" data-i18n="labelLeague">3. Liga</label>
                        <select id="filter-league" onchange="onLeagueChange()" class="w-full glass-panel text-sm p-2.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todas as Ligas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase font-bold mb-1 opacity-75" data-i18n="labelTeam">4. Time</label>
                        <select id="filter-team" onchange="onTeamChange()" class="w-full glass-panel text-sm p-2.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todos os Times</option>
                        </select>
                    </div>
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-[10px] uppercase font-bold mb-1 opacity-75" data-i18n="labelPlayer">5. Jogador / Atleta</label>
                        <select id="filter-player" onchange="filterMatches()" class="w-full glass-panel text-sm p-2.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todos os Jogadores</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Video Player & Live Interaction Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Main Streaming Player -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="relative aspect-video bg-black rounded-2xl overflow-hidden border border-rose-900/40 shadow-2xl group">
                        <canvas id="stream-canvas" class="w-full h-full object-cover"></canvas>

                        <!-- Top Overlay -->
                        <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2">
                            <span class="flex items-center space-x-1.5 bg-rose-600 text-white font-black text-xs px-3 py-1 rounded-full animate-pulse shadow">
                                <span class="w-2 h-2 rounded-full bg-white"></span>
                                <span>LIVE 4K</span>
                            </span>
                            <span id="current-stream-title" class="text-white text-xs sm:text-sm font-bold bg-black/70 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
                                Real Madrid vs FC Barcelona — La Liga
                            </span>
                        </div>

                        <!-- Multi-Cam Switcher -->
                        <div class="absolute top-4 right-4 flex space-x-1.5">
                            <button onclick="setCamMode('main')" id="cam-main" class="bg-rose-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg border border-white/20 transition">
                                <i class="fa-solid fa-video mr-1"></i> Principal
                            </button>
                            <button onclick="setCamMode('tactical')" id="cam-tactical" class="bg-black/70 hover:bg-rose-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg border border-white/20 transition">
                                <i class="fa-solid fa-chess-board mr-1"></i> Tática
                            </button>
                            <button onclick="setCamMode('player')" id="cam-player" class="bg-black/70 hover:bg-rose-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg border border-white/20 transition">
                                <i class="fa-solid fa-user-astronaut mr-1"></i> Star Cam
                            </button>
                        </div>

                        <!-- Bottom Controls -->
                        <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-black via-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <div class="w-full bg-gray-700/60 h-1.5 rounded-full mb-3 cursor-pointer overflow-hidden">
                                <div class="bg-rose-600 h-full w-3/4"></div>
                            </div>
                            <div class="flex items-center justify-between text-white">
                                <div class="flex items-center space-x-4">
                                    <button onclick="togglePlay()" class="hover:text-rose-500 transition"><i id="play-icon" class="fa-solid fa-pause text-lg"></i></button>
                                    <button class="hover:text-rose-500 transition"><i class="fa-solid fa-volume-high"></i></button>
                                    <span class="text-xs text-gray-300 font-mono">68:45 / 90:00</span>
                                </div>
                                <div class="flex items-center space-x-3 text-xs">
                                    <span class="bg-rose-900/80 border border-rose-500/40 px-2 py-0.5 rounded text-rose-200 font-bold">ULTRA HD 60FPS</span>
                                    <button onclick="toggleFullscreen()" class="hover:text-rose-500 transition"><i class="fa-solid fa-expand"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Match Metadata & Quick Actions (Watch Party + Stats) -->
                    <div class="glass-panel p-4 rounded-2xl flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-11 h-11 rounded-xl red-gradient flex items-center justify-center font-black text-white shadow">
                                VS
                            </div>
                            <div>
                                <h4 id="match-teams-detail" class="font-bold text-base sm:text-lg">Real Madrid CF vs FC Barcelona</h4>
                                <p id="match-league-detail" class="text-xs opacity-75">Espanha • La Liga • Destaque: Vinícius Jr & Lamine Yamal</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="createWatchParty()" class="px-3.5 py-2 rounded-xl border border-rose-500/50 hover:bg-rose-600/20 text-rose-500 text-xs font-bold transition">
                                <i class="fa-solid fa-user-group mr-1.5"></i> Watch Party
                            </button>
                            <button onclick="toggleStatsDrawer()" class="px-3.5 py-2 rounded-xl red-gradient text-white text-xs font-bold shadow hover:brightness-110 transition">
                                <i class="fa-solid fa-chart-simple mr-1.5"></i> Stats ao Vivo
                            </button>
                        </div>
                    </div>

                    <!-- Collapsible Live Stats Drawer -->
                    <div id="live-stats-drawer" class="hidden glass-panel p-4 rounded-2xl border border-rose-500/40 space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-black uppercase tracking-wider text-rose-500">Estatísticas em Tempo Real</span>
                            <button onclick="toggleStatsDrawer()" class="text-xs opacity-70 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                        <div class="space-y-2 text-xs">
                            <div>
                                <div class="flex justify-between font-bold mb-1"><span>54%</span><span>Posse de Bola</span><span>46%</span></div>
                                <div class="w-full h-2 bg-gray-700 rounded-full overflow-hidden flex">
                                    <div class="bg-rose-600 h-full" style="width: 54%"></div>
                                    <div class="bg-amber-500 h-full" style="width: 46%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between font-bold mb-1"><span>14</span><span>Finalizações</span><span>11</span></div>
                                <div class="w-full h-2 bg-gray-700 rounded-full overflow-hidden flex">
                                    <div class="bg-rose-600 h-full" style="width: 56%"></div>
                                    <div class="bg-amber-500 h-full" style="width: 44%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live Fan Chat -->
                <div class="glass-panel rounded-2xl flex flex-col h-[490px] border border-rose-900/30">
                    <div class="p-3.5 border-b border-rose-900/30 flex items-center justify-between">
                        <span class="text-xs font-bold text-rose-500 uppercase tracking-widest flex items-center">
                            <i class="fa-solid fa-comments mr-2"></i> Chat Global ao Vivo
                        </span>
                        <span class="text-[10px] bg-rose-600/20 text-rose-500 border border-rose-500/30 px-2 py-0.5 rounded-full font-bold">18.4k online</span>
                    </div>
                    
                    <div id="chat-messages" class="flex-grow p-3.5 space-y-2.5 overflow-y-auto text-xs">
                        <div class="p-2.5 rounded-xl bg-rose-950/20 border border-rose-900/20">
                            <span class="font-bold text-rose-500">Lucas_BR 🇧🇷:</span>
                            <span class="ml-1">Que transmissão limpa em 4K! Vini Jr voando em campo! 🔥</span>
                        </div>
                        <div class="p-2.5 rounded-xl bg-rose-950/20 border border-rose-900/20">
                            <span class="font-bold text-amber-500">Hans_DE 🇩🇪:</span>
                            <span class="ml-1">Unglaubliches Tempo in der zweiten Halbzeit! ⚽</span>
                        </div>
                        <div class="p-2.5 rounded-xl bg-rose-950/20 border border-rose-900/20">
                            <span class="font-bold text-emerald-500">Kenji_JP 🇯🇵:</span>
                            <span class="ml-1">最高の画質とカメラアングル！</span>
                        </div>
                    </div>

                    <div class="p-3 border-t border-rose-900/30 flex space-x-2">
                        <input id="chat-input" onkeypress="if(event.key==='Enter') sendChatMessage()" type="text" placeholder="Comente sobre o jogo..." class="flex-grow glass-panel text-xs px-3 py-2.5 rounded-xl focus:outline-none focus:ring-1 focus:ring-rose-500">
                        <button onclick="sendChatMessage()" class="red-gradient text-white px-3.5 py-2.5 rounded-xl text-xs font-bold hover:brightness-110">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Available Matches & Catalog Grid -->
            <div>
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold flex items-center text-rose-500">
                        <i class="fa-solid fa-tower-broadcast mr-2"></i> Jogos, Ligas & Atletas Disponíveis
                    </h3>
                    <span id="results-counter" class="text-xs font-bold opacity-75"></span>
                </div>
                <div id="matches-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
            </div>
        </div>

        <!-- TAB 2: SEARCH & ADVANCED FILTERS -->
        <div id="tab-search-content" class="hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-rose-900/30 space-y-4">
                <h2 class="text-xl font-bold flex items-center text-rose-500">
                    <i class="fa-solid fa-magnifying-glass mr-2"></i> Pesquisa Avançada (Times, Jogadores, Ligas e Países)
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div class="md:col-span-2 relative">
                        <input type="text" id="global-search-input" onkeyup="handleSearch()" placeholder="Busque por Haaland, Vinícius Jr, Flamengo, Lakers, Verstappen, Premier League..." 
                            class="w-full glass-panel text-sm px-4 py-3.5 pl-11 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-4 text-rose-500"></i>
                    </div>
                    <div>
                        <select id="search-sport-filter" onchange="handleSearch()" class="w-full glass-panel text-sm p-3.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todas as Modalidades</option>
                            <option value="Futebol">Futebol</option>
                            <option value="Basquete">Basquete</option>
                            <option value="Automobilismo">Automobilismo</option>
                            <option value="Tênis">Tênis</option>
                            <option value="Lutas">Lutas (UFC)</option>
                            <option value="Futebol Americano">Futebol Americano (NFL)</option>
                        </select>
                    </div>
                    <div>
                        <select id="search-status-filter" onchange="handleSearch()" class="w-full glass-panel text-sm p-3.5 rounded-xl focus:ring-2 focus:ring-rose-500">
                            <option value="all">Todos os Status</option>
                            <option value="LIVE">Somente AO VIVO</option>
                            <option value="UPCOMING">Próximos Jogos</option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="search-results" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        </div>

        <!-- TAB 3: SPORTS NEWS -->
        <div id="tab-news-content" class="hidden space-y-6">
            <div class="relative rounded-2xl overflow-hidden glass-panel border border-rose-900/40 p-8 flex flex-col justify-end min-h-[300px]"
                 style="background: linear-gradient(to top, rgba(10,10,13,0.95) 15%, rgba(76,5,25,0.4) 100%), url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80') center/cover;">
                <span class="bg-rose-600 text-white font-bold text-xs uppercase px-3 py-1 rounded-full w-max mb-2">Manchete Principal</span>
                <h1 class="text-2xl md:text-4xl font-extrabold text-white mb-2">Temporada Europeia & Mundial: Os Maiores Craques em Ação</h1>
                <p class="text-sm text-gray-200 max-w-2xl">Acompanhe análises exclusivas, bastidores das principais ligas do mundo, mercado da bola e estatísticas detalhadas.</p>
            </div>

            <div id="news-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6"></div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-rose-900/30 glass-panel mt-12 py-6">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs opacity-75 space-y-1">
            <p class="font-bold">© 2026 Assista Comigo / Watch With Me v2.0 PRO</p>
            <p>Plataforma Multi-Idioma de Transmissões Esportivas & Notícias em Tempo Real</p>
        </div>
    </footer>

    <script>
        // Rich Multi-Sport, Multi-Country, League, Team & Player Catalog
        const catalogDB = [
            // Futebol - Espanha (La Liga)
            { sport: "Futebol", country: "Espanha", league: "La Liga", team: "Real Madrid", opponent: "FC Barcelona", players: ["Vinícius Jr", "Jude Bellingham", "Kylian Mbappé", "Rodrygo", "Federico Valverde"], status: "LIVE", time: "AO VIVO • 68'", thumb: "https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=600&q=80" },
            { sport: "Futebol", country: "Espanha", league: "La Liga", team: "FC Barcelona", opponent: "Atlético de Madrid", players: ["Lamine Yamal", "Pedri", "Robert Lewandowski", "Raphinha", "Gavi"], status: "LIVE", time: "AO VIVO • 52'", thumb: "https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=600&q=80" },
