                    <span class="font-bold text-rose-500">Você:</span>
                    <span class="ml-1">${msg}</span>
                </div>
            `;
            input.value = '';
            chat.scrollTop = chat.scrollHeight;
        }

        function createWatchParty() {
            const code = 'AC-' + Math.random().toString(36).substring(2, 7).toUpperCase();
            alert(`Sala Watch Party Criada!\nCompartilhe o código com seus amigos: ${code}`);
        }

        function toggleStatsDrawer() {
            document.getElementById('live-stats-drawer').classList.toggle('hidden');
        }

        function setCamMode(mode) {
            camMode = mode;
            ['main', 'tactical', 'player'].forEach(m => {
                const btn = document.getElementById(`cam-${m}`);
                btn.classList.remove('bg-rose-600');
                btn.classList.add('bg-black/70');
            });
            const active = document.getElementById(`cam-${mode}`);
            active.classList.remove('bg-black/70');
            active.classList.add('bg-rose-600');
        }

        function togglePlay() {
            isPlaying = !isPlaying;
            const icon = document.getElementById('play-icon');
            icon.className = isPlaying ? 'fa-solid fa-pause text-lg' : 'fa-solid fa-play text-lg';
        }

        function toggleFullscreen() {
            const canvas = document.getElementById('stream-canvas');
            if (canvas.requestFullscreen) canvas.requestFullscreen();
        }

        function initCanvasStream() {
            const canvas = document.getElementById('stream-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 1280;
            canvas.height = 720;

            let ballX = 640, ballY = 360, dx = 5, dy = 3.5;

            function animate() {
                if (isPlaying) {
                    const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
                    if (camMode === 'tactical') {
                        grad.addColorStop(0, '#090d16');
                        grad.addColorStop(1, '#1e1b4b');
                    } else if (camMode === 'player') {
                        grad.addColorStop(0, '#2a040e');
                        grad.addColorStop(1, '#0a0a0d');
                    } else {
                        grad.addColorStop(0, '#052e16');
                        grad.addColorStop(1, '#064e3b');
                    }
                    ctx.fillStyle = grad;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);

                    // Field Lines
                    ctx.strokeStyle = 'rgba(255,255,255,0.28)';
                    ctx.lineWidth = 4;
                    ctx.strokeRect(60, 60, canvas.width - 120, canvas.height - 120);
                    ctx.beginPath();
                    ctx.moveTo(canvas.width / 2, 60);
                    ctx.lineTo(canvas.width / 2, canvas.height - 60);
                    ctx.stroke();
                    ctx.beginPath();
                    ctx.arc(canvas.width / 2, canvas.height / 2, 95, 0, Math.PI * 2);
                    ctx.stroke();

                    // Simulated Players
                    ctx.fillStyle = '#e11d48';
                    ctx.beginPath(); ctx.arc(ballX - 70, ballY - 30, 14, 0, Math.PI * 2); ctx.fill();
                    ctx.fillStyle = '#facc15';
                    ctx.beginPath(); ctx.arc(ballX + 80, ballY + 40, 14, 0, Math.PI * 2); ctx.fill();

                    // Ball
                    ctx.fillStyle = '#ffffff';
                    ctx.beginPath();
                    ctx.arc(ballX, ballY, 10, 0, Math.PI * 2);
                    ctx.fill();

                    ballX += dx;
                    ballY += dy;
                    if (ballX > canvas.width - 80 || ballX < 80) dx = -dx;
                    if (ballY > canvas.height - 80 || ballY < 80) dy = -dy;
                }
                requestAnimationFrame(animate);
            }
            animate();
        }

        window.onload = function() {
            updateCascadingDropdowns();
            renderMatchesGrid(catalogDB);
            renderNews();
            initCanvasStream();
        };
    </script>
</body>
</html>
