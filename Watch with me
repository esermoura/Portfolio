        function switchTab(tab) {
            ['live', 'search', 'news'].forEach(t => {
                document.getElementById(`tab-${t}-content`).classList.add('hidden');
                const btn = document.getElementById(`tab-btn-${t}`);
                if (btn) {
                    btn.classList.remove('red-gradient', 'text-white', 'shadow');
                }
            });
            document.getElementById(`tab-${tab}-content`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tab}`);
            if (activeBtn) {
                activeBtn.classList.add('red-gradient', 'text-white', 'shadow');
            }
            if (tab === 'search') handleSearch();
        }

        function changeLanguage(lang) {
            const data = translations[lang] || translations.pt;
            document.getElementById('brand-name').innerText = data.brand;
            document.title = `${data.brand} v2.0 PRO`;
            document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (data[key]) el.innerText = data[key];
            });
        }

        function toggleTheme() {
            document.body.classList.toggle('light-theme');
            const icon = document.getElementById('theme-icon');
            if (document.body.classList.contains('light-theme')) {
                icon.classList.replace('fa-sun', 'fa-moon');
            } else {
                icon.classList.replace('fa-moon', 'fa-sun');
            }
        }

        // Cascading Hierarchical Drilldown Logic
        function populateSelect(id, items, defaultLabel) {
            const select = document.getElementById(id);
            const currentVal = select.value;
            select.innerHTML = `<option value="all">${defaultLabel}</option>`;
            [...new Set(items)].sort().forEach(item => {
                select.innerHTML += `<option value="${item}">${item}</option>`;
            });
            if (items.includes(currentVal)) select.value = currentVal;
        }

        function updateCascadingDropdowns() {
            const sport = document.getElementById('filter-sport').value;
            const country = document.getElementById('filter-country').value;
            const league = document.getElementById('filter-league').value;
            const team = document.getElementById('filter-team').value;

            populateSelect('filter-sport', catalogDB.map(d => d.sport), 'Todos os Esportes');

            const bySport = sport === 'all' ? catalogDB : catalogDB.filter(d => d.sport === sport);
            populateSelect('filter-country', bySport.map(d => d.country), 'Todos os Países');

            const byCountry = country === 'all' ? bySport : bySport.filter(d => d.country === country);
            populateSelect('filter-league', byCountry.map(d => d.league), 'Todas as Ligas');

            const byLeague = league === 'all' ? byCountry : byCountry.filter(d => d.league === league);
            populateSelect('filter-team', byLeague.map(d => d.team), 'Todos os Times');

            const byTeam = team === 'all' ? byLeague : byLeague.filter(d => d.team === team);
            const allPlayers = byTeam.flatMap(d => d.players);
            populateSelect('filter-player', allPlayers, 'Todos os Jogadores');
        }

        function onSportChange() {
            document.getElementById('filter-country').value = 'all';
            document.getElementById('filter-league').value = 'all';
            document.getElementById('filter-team').value = 'all';
            document.getElementById('filter-player').value = 'all';
            updateCascadingDropdowns();
            filterMatches();
        }

        function onCountryChange() {
            document.getElementById('filter-league').value = 'all';
            document.getElementById('filter-team').value = 'all';
            document.getElementById('filter-player').value = 'all';
            updateCascadingDropdowns();
            filterMatches();
        }

        function onLeagueChange() {
            document.getElementById('filter-team').value = 'all';
            document.getElementById('filter-player').value = 'all';
            updateCascadingDropdowns();
            filterMatches();
        }

        function onTeamChange() {
            document.getElementById('filter-player').value = 'all';
            updateCascadingDropdowns();
            filterMatches();
        }

        function resetFilters() {
            document.getElementById('filter-sport').value = 'all';
