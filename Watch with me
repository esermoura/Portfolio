        function filterMatches() {
            const sport = document.getElementById('filter-sport').value;
            const country = document.getElementById('filter-country').value;
            const league = document.getElementById('filter-league').value;
            const team = document.getElementById('filter-team').value;
            const player = document.getElementById('filter-player').value;

            const filtered = catalogDB.filter(item => {
                return (sport === 'all' || item.sport === sport) &&
                       (country === 'all' || item.country === country) &&
                       (league === 'all' || item.league === league) &&
                       (team === 'all' || item.team === team) &&
                       (player === 'all' || item.players.includes(player));
            });

            renderMatchesGrid(filtered);
        }

        function renderMatchesGrid(list) {
            const grid = document.getElementById('matches-grid');
            document.getElementById('results-counter').innerText = `${list.length} transmissões encontradas`;
            grid.innerHTML = '';

            if (list.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-10 opacity-70">Nenhuma partida encontrada para esta combinação de filtros.</div>`;
                return;
            }

            list.forEach(item => {
                const badgeClass = item.status === 'LIVE' ? 'bg-rose-600 animate-pulse' : 'bg-zinc-800 border border-white/20';
                grid.innerHTML += `
                    <div class="glass-panel rounded-2xl overflow-hidden border border-rose-900/30 hover:border-rose-500 transition cursor-pointer group" 
                         onclick="selectStream('${item.team} vs ${item.opponent}', '${item.country} • ${item.league} • Elenco: ${item.players.slice(0,3).join(', ')}')">
                        <div class="relative h-40 overflow-hidden">
                            <img src="${item.thumb}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="${item.team}">
                            <div class="absolute top-2.5 right-2.5 ${badgeClass} text-white font-bold text-[10px] px-2.5 py-1 rounded-full shadow">
                                ${item.time}
                            </div>
                        </div>
                        <div class="p-4 space-y-2">
                            <div class="text-[10px] text-rose-500 font-extrabold uppercase tracking-wider">
                                ${item.sport} • ${item.country} • ${item.league}
                            </div>
                            <h4 class="font-bold text-base">${item.team} vs ${item.opponent}</h4>
                            <p class="text-xs opacity-75 line-clamp-1">
                                <i class="fa-solid fa-users mr-1 text-rose-500"></i> ${item.players.join(', ')}
                            </p>
                        </div>
                    </div>
                `;
            });
        }

        function selectStream(title, detail) {
            document.getElementById('current-stream-title').innerText = title;
            document.getElementById('match-teams-detail').innerText = title;
            document.getElementById('match-league-detail').innerText = detail;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function handleSearch() {
            const q = document.getElementById('global-search-input').value.toLowerCase();
            const sportFilter = document.getElementById('search-sport-filter').value;
            const statusFilter = document.getElementById('search-status-filter').value;
            const container = document.getElementById('search-results');

            const results = catalogDB.filter(item => {
                const matchText = item.team.toLowerCase().includes(q) ||
                                  item.opponent.toLowerCase().includes(q) ||
                                  item.league.toLowerCase().includes(q) ||
                                  item.country.toLowerCase().includes(q) ||
                                  item.players.some(p => p.toLowerCase().includes(q));
                const matchSport = sportFilter === 'all' || item.sport === sportFilter;
                const matchStatus = statusFilter === 'all' || item.status === statusFilter;
                return matchText && matchSport && matchStatus;
            });

            container.innerHTML = '';
            if (results.length === 0) {
                container.innerHTML = `<div class="col-span-full text-center py-10 opacity-70">Nenhum resultado encontrado para "${q}".</div>`;
                return;
            }

            results.forEach(item => {
                container.innerHTML += `
                    <div onclick="switchTab('live'); selectStream('${item.team} vs ${item.opponent}', '${item.country} • ${item.league}')" 
                         class="glass-panel p-4 rounded-2xl border border-rose-900/30 hover:border-rose-500 cursor-pointer flex items-center space-x-4 transition">
                        <img src="${item.thumb}" class="w-20 h-20 rounded-xl object-cover flex-shrink-0">
                        <div class="space-y-1">
                            <span class="text-[10px] text-rose-500 font-black uppercase">${item.sport} • ${item.league}</span>
                            <h4 class="font-bold text-sm">${item.team} vs ${item.opponent}</h4>
                            <p class="text-xs opacity-75 line-clamp-2">${item.players.join(', ')}</p>
                        </div>
                    </div>
                `;
            });
        }

